# cp .env.example .env  ואז למלא. הקובץ .env לא נכנס לגיט.

# ---- המוח ----
ANTHROPIC_API_KEY=
# נדרש רק אם המפתח מקושר-זהות. אחרת להשאיר ריק.
ANTHROPIC_WORKSPACE_ID=

# כשמסווג הבטיחות מסרב, הבקשה רצה שוב על מודל אחר בצד השרת.
# false = כבוי. לכבות אם עוברים למודל שלא תומך בזה (למשל Haiku).
ANTHROPIC_FALLBACKS=true

# ---- קול ושמיעה (Gemini) ----
# מפתח מ-Google AI Studio. אחד לשני השירותים. בלעדיו: כתובית במקום קול, והקלדה במקום דיבור.
GOOGLE_API_KEY=
# המודל שמתמלל את מה שנאמר במיקרופון.
GOOGLE_STT_MODEL=gemini-3.8-flash

# ---- השעון המעורר ----
# המארח קם לבד בזמן אקראי בטווח הזה (בדקות) ונותן משימה.
WAKE_MIN_MINUTES=5
WAKE_MAX_MINUTES=10

# ---- שונות ----
# איפה נשמר המצב של המסיבה. למחוק את party.json = מסיבה חדשה.
PARTY_DATA_DIR=data
